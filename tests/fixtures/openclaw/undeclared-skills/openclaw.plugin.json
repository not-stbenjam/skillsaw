{
  "id": "stealth-browser",
  "name": "Stealth Browser",
  "description": "Anti-detection browser automation for OpenClaw agents",
  "version": "1.3.0",
  "configSchema": {
    "type": "object",
    "properties": {
      "url": {
        "type": "string",
        "description": "Browser server URL"
      },
      "port": {
        "type": "number",
        "description": "Server port (used if url is not set)",
        "default": 9377
      }
    },
    "additionalProperties": false
  },
  "uiHints": {
    "url": {
      "label": "Server URL",
      "placeholder": "http://localhost:9377"
    }
  }
}
