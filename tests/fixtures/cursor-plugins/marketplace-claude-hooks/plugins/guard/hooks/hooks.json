{
  "description": "Secret guard hooks for Claude Code",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/scripts/deny-secrets.sh",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
